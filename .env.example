# Mneme base URL (default when serve runs on 8791)
MNEME_BASE_URL=http://127.0.0.1:8791

# OpenAI-compatible LLM (Ollama / vLLM / OpenAI / 国内兼容网关均可)
# Ollama 示例:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# Retrieval
SEARCH_MODE=hybrid
SEARCH_LIMIT=6
# SEARCH_KIND=all

# HTTP timeout (seconds) for Mneme API
REQUEST_TIMEOUT=60
